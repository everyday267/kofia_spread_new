Sub CrackHashes()
    Dim enc As Object, sha As Object
    Set enc = CreateObject("System.Text.UTF8Encoding")
    Set sha = CreateObject("System.Security.Cryptography.SHA256Managed")

    Dim wsH As Worksheet, wsR As Worksheet, wsP As Worksheet
    Set wsH = ThisWorkbook.Sheets("hashes")
    Set wsR = GetOrAdd("result")
    Set wsP = GetOrAdd("progress")

    ' 1) A열 해시 적재 (True=찾는 중)
    Dim dict As Object: Set dict = CreateObject("Scripting.Dictionary")
    Dim lastRow As Long, r As Long, h As String
    lastRow = wsH.Cells(wsH.Rows.Count, 1).End(xlUp).Row
    For r = 1 To lastRow
        h = LCase(Trim(CStr(wsH.Cells(r, 1).Value)))
        If Len(h) = 64 Then dict(h) = True
    Next r

    ' 2) 이미 찾은 것(result 시트)은 건너뛰기 — 이어하기용
    Dim foundCount As Long: foundCount = 0
    If wsR.Cells(1, 1).Value = "hash" Then
        Dim lr As Long, rr As Long
        lr = wsR.Cells(wsR.Rows.Count, 1).End(xlUp).Row
        For rr = 2 To lr
            h = LCase(Trim(CStr(wsR.Cells(rr, 1).Value)))
            If dict.Exists(h) Then If dict(h) = True Then dict(h) = False: foundCount = foundCount + 1
        Next rr
    Else
        wsR.Cells(1, 1).Value = "hash": wsR.Cells(1, 2).Value = "original"
    End If
    Dim total As Long: total = dict.Count

    ' 3) 이어하기 위치 읽기
    Dim startYear As Long, startSeq As Long
    startYear = 2021: startSeq = 0
    If IsNumeric(wsP.Range("B1").Value) Then startYear = CLng(wsP.Range("B1").Value)
    If IsNumeric(wsP.Range("B2").Value) Then startSeq = CLng(wsP.Range("B2").Value)
    wsP.Range("A1").Value = "resumeYear": wsP.Range("A2").Value = "resumeSeq"

    Dim maxSeq As Long: maxSeq = 99999999   ' 상한을 88888888로 바꾸려면 여기만 수정
    Dim yr As Long, seq As Long, s0 As Long, cand As String, hx As String
    Dim nextRow As Long
    nextRow = wsR.Cells(wsR.Rows.Count, 1).End(xlUp).Row + 1

    Application.ScreenUpdating = False
    For yr = startYear To 2026
        If yr = startYear Then s0 = startSeq Else s0 = 0
        For seq = s0 To maxSeq
            cand = "100000" & yr & Format(seq, "00000000")
            hx = ToHex(sha.ComputeHash_2(enc.GetBytes_4(cand)))
            If dict.Exists(hx) Then
                If dict(hx) = True Then
                    dict(hx) = False
                    foundCount = foundCount + 1
                    wsR.Cells(nextRow, 1).Value = hx
                    wsR.Cells(nextRow, 2).Value = "'" & cand   ' 텍스트로 저장(18자리 보존)
                    nextRow = nextRow + 1
                    If foundCount = total Then GoTo Done
                End If
            End If
            If (seq And 1048575) = 0 Then     ' 약 100만마다 위치 저장 + 표시
                wsP.Range("B1").Value = yr
                wsP.Range("B2").Value = seq
                Application.StatusBar = yr & " / 순번 " & Format(seq, "#,##0") & "  |  복원 " & foundCount & "/" & total
                DoEvents
            End If
        Next seq
    Next yr
Done:
    wsP.Range("B1").Value = 2027: wsP.Range("B2").Value = 0   ' 완료 표시
    Application.ScreenUpdating = True
    Application.StatusBar = False
    MsgBox foundCount & " / " & total & " 개 복원 완료 (result 시트)"
End Sub

Function GetOrAdd(nm As String) As Worksheet
    On Error Resume Next
    Set GetOrAdd = ThisWorkbook.Sheets(nm)
    On Error GoTo 0
    If GetOrAdd Is Nothing Then
        Set GetOrAdd = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
        GetOrAdd.Name = nm
    End If
End Function

Function ToHex(bytes As Variant) As String   ' 바이트배열 → 소문자 16진수
    Dim i As Long, s As String
    For i = 0 To UBound(bytes)
        s = s & Right$("0" & Hex$(bytes(i) And 255), 2)
    Next i
    ToHex = LCase$(s)
End Function
